# Copy to .env and fill in. NEVER commit the real .env.

# --- database ---
MONGO_URL=mongodb://localhost:27017
MONGO_DB_NAME=code_review_agent

# --- auth ---
# generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-your-local-env
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=14

# encrypts per-user GitHub tokens at rest
# generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=change-me-in-your-local-env

# --- llm (ollama, local) ---
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=qwen3.6:35b-a3b
LLM_TEMPERATURE=0.1
LLM_SEED=42
LLM_NUM_CTX=16384
LLM_TIMEOUT_SECONDS=300

# --- analysis limits ---
MAX_UPLOAD_BYTES=10485760
MAX_FILES_PER_REVIEW=200
MAX_FILE_BYTES=524288

# --- integrations ---
# optional fallback token for public PR fetching; per-user tokens live in mongo (encrypted)
GITHUB_TOKEN=
CI_SHARED_SECRET=

# --- app ---
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO
